# Configuración pública de EmailJS para el formulario de contacto.
# Copia este archivo como .env.local y completa los valores en tu entorno.
# Estas variables se incluyen en el cliente y no deben contener claves privadas.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
